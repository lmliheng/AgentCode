{
  "name": "agentcode",
  "version": "1.0.3",
  "description": "Agent应用学习仓库",
  "main": "index.js",
  "scripts": {
    "chat:llm": "tsx --env-file=.env src/LLM/chat.ts chat",
    "balance:llm": "tsx --env-file=.env src/LLM/chat.ts balance",
    "tool_calling:tool": "tsx --env-file=.env src/MCP/ToolCalling/toolcalling.ts",
    "agent": "tsx --env-file=.env MyAgent/index.js ",
    "comsume:script": "tsx --env-file=.env scripts/ai_git.js comsume",
    "commits:script": "tsx --env-file=.env scripts/ai_git.js commits",
    "batch:script": "tsx --env-file=.env scripts/ai_git.js batch",
    "query_better:prompt": "tsx --env-file=.env src/Prompt/提示词优化器/query.ts --test",
    "rerank:rag": " tsx --env-file=.env src/RAG/reRank/rerank.ts --test",
    "embedding:rag": "tsx --env-file=.env src/RAG/向量模型/embedding_test.js",
    "vectorRetriever:rag": "tsx --env-file=.env src/RAG/向量检索器/VectorRetriever.js test",
    "search:rag": "node --env-file=.env index.js --search",
    "init:rag": "node --env-file=.env index.js",
    "collection:rag": "node --env-file=.env milvus/collection.js",
    "database:rag": "node --env-file=.env milvus/database.js",
    "connect:rag": "node --env-file=.env milvus/connect.js",
    "generate:langchain": "node --env-file=.env LangChain/SDK/langchain_deepseek.js --generate",
    "chat:langchain": "node --env-file=.env LangChain/SDK/langchain_deepseek.js --chat",
    "message:langchain": "node --env-file=.env LangChain/SDK/langchain_deepseek.js --message",
    "tool:langchain": "node --env-file=.env LangChain/SDK/langchain_deepseek.js --tool",
    "test:langchain": "node --env-file=.env LangChain/langchain.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmliheng/AgentCode.git"
  },
  "keywords": [
    "Agent",
    "mcp",
    "rag",
    "llm"
