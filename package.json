{
  "name": "agentcode",
  "version": "1.0.3",
  "description": "Agent应用学习仓库",
  "main": "index.js",
  "scripts": {
    "chat": "tsx --env-file=.env src/LLM/chat.ts chat",
    "balance": "tsx --env-file=.env src/LLM/chat.ts balance",
    "tool_calling": "tsx --env-file=.env src/MCP/ToolCalling/toolcalling.ts",
    "agent": "tsx --env-file=.env MyAgent/index.js ",
    "comsume": "tsx --env-file=.env scripts/ai_git.js comsume",
    "commits": "tsx --env-file=.env scripts/ai_git.js commits",
    "batch": "tsx --env-file=.env scripts/ai_git.js batch",
    "query_better": "tsx --env-file=.env src/Prompt/提示词优化器/query.ts --test",
    "rerank": " tsx --env-file=.env src/RAG/reRank/rerank.ts --test",
    "embedding": "tsx --env-file=.env src/RAG/向量模型/embedding_test.js",
    "vectorRetriever": "tsx --env-file=.env src/RAG/向量检索器/VectorRetriever.js test",
    "search": "node --env-file=.env index.js --search",
    "init": "node --env-file=.env index.js",
    "collection": "node --env-file=.env milvus/collection.js",
    "database": "node --env-file=.env milvus/database.js",
    "connect": "node --env-file=.env milvus/connect.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmliheng/AgentCode.git"
  },
  "keywords": [
    "Agent",
    "mcp",
    "rag",
    "llm"
  ],
  "author": "lmliheng",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/lmliheng/AgentCode/issues"
  },
  "homepage": "https://github.com/lmliheng/AgentCode#readme",
  "dependencies": {
    "@lmliheng/ai_git": "^1.0.8",
    "@lmliheng/rag-chunk": "^1.0.2",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@zilliz/milvus2-sdk-node": "^3.0.4",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2"
  }
}
