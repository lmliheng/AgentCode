  "dependencies": {
    "@langchain/core": "^1.2.8",
    "@langchain/deepseek": "^1.1.8",
    "@lmliheng/filesystem-mcp": "^1.0.7",
    "langchain": "^1.5.9",
    "@lmliheng/ai_git": "^1.0.8",
    "@lmliheng/rag-chunk": "^1.0.2",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@zilliz/milvus2-sdk-node": "^3.0.4",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2"
  }
